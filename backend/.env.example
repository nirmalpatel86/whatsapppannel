PORT=4001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whatsapp_panel
DB_USER=root
DB_PASSWORD=your_password
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins, e.g. https://panel.example.com.
# Leave unset to allow all origins (fine for local dev; set this in production).
CORS_ORIGIN=
# Set to "true" for local development to auto-pick-up model field changes on every boot.
# Leave unset/false on any server that can crash-loop (pm2/systemd) — repeated ALTER TABLE
# on an already-correct schema duplicates indexes until MySQL's 64-key limit is hit. Use
# backend/scripts/generateSchemaSql.js + database/schema/*.sql to create a fresh database.
DB_AUTO_ALTER=false
UPLOAD_DIR=./uploads
# WhatsApp chat/campaign media (sent + received) older than this is auto-deleted daily, so the
# uploads folder doesn't grow forever. Set higher if you need to keep media longer.
UPLOAD_RETENTION_DAYS=30

# SMS Panel Database
SMS_DB_NAME=sms_panel
SMS_DB_HOST=localhost
SMS_DB_PORT=3306
SMS_DB_USER=root
SMS_DB_PASSWORD=your_password

# BulkMail Panel Database
BULKMAIL_DB_NAME=bulkmail_panel
BULKMAIL_DB_HOST=localhost
BULKMAIL_DB_PORT=3306
BULKMAIL_DB_USER=root
BULKMAIL_DB_PASSWORD=your_password

# --- One-time migration from the old PHP projects (see migrations/README.md) ---
# Only needed when running migrations/migrate-sms.js
OLD_SMS_DB_NAME=shudhsms
OLD_SMS_DB_HOST=localhost
OLD_SMS_DB_PORT=3306
OLD_SMS_DB_USER=root
OLD_SMS_DB_PASSWORD=your_password

# Only needed when running migrations/migrate-bulkmail.js
OLD_BULKMAIL_DB_NAME=bulkmail_new
OLD_BULKMAIL_DB_HOST=localhost
OLD_BULKMAIL_DB_PORT=3306
OLD_BULKMAIL_DB_USER=root
OLD_BULKMAIL_DB_PASSWORD=your_password
